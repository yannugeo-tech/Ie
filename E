local lastTriggerShot = 0

RunService.RenderStepped:Connect(function()
    local isAimbotOn = Toggles.AimbotToggle and Toggles.AimbotToggle.Value
    local isLegitOn = Toggles.LegitAimbotToggle and Toggles.LegitAimbotToggle.Value
    if isAimbotOn or isLegitOn then
        local nearestTarget = getBestTarget()
        if nearestTarget then
            local pos, onScreen = Camera:WorldToViewportPoint(nearestTarget.Position)
            local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
            if onScreen and distance <= Options.FOVSlider.Value then
                if isAimbotOn then
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, nearestTarget.Position)
                elseif isLegitOn then
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, nearestTarget.Position), Options.LegitSmoothness.Value)
                end
            end
        end
    end
    if Toggles.TriggerbotToggle and Toggles.TriggerbotToggle.Value then
        local ray = Camera:ViewportPointToRay(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        local raycastResult = Workspace:Raycast(ray.Origin, ray.Direction * 1000)
        if raycastResult and raycastResult.Instance then
            local hitModel = raycastResult.Instance:FindFirstAncestorOfClass("Model")
            if hitModel then
                local plr = Players:GetPlayerFromCharacter(hitModel)
                if plr and plr ~= LocalPlayer and not isSameTeam(plr) then
                    if tick() - lastTriggerShot >= Options.TriggerDelay.Value then lastTriggerShot = tick(); mouse1click() end
                end
            end
        end
    end
end)

