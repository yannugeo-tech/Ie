end)

local isVoidBaiting = false
local function TriggerVoidBait()
    if isVoidBaiting then return end
    
    local targetHead = _halmu.currentTarget or getBestTarget()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    if not myRoot or not targetHead or not targetHead.Parent then
        Library:Notify("Bait Error: No valid target found!", 3)
        return
    end

    local targetChar = targetHead.Parent
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    isVoidBaiting = true
    Library:Notify("Executing Void Bait on Target!", 2)

    local savedCF = myRoot.CFrame
    local voidCF = savedCF - Vector3.new(0, 500, 0)

    task.spawn(function()
        for i = 1, 5 do
            if myRoot and targetRoot then
                myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, -2, 1)
                myRoot.AssemblyLinearVelocity = Vector3.new(0, -500, 0)
            end
            task.wait(0.01)
        end
        
        for i = 1, 10 do
            if myRoot then
                myRoot.CFrame = voidCF
                myRoot.AssemblyLinearVelocity = Vector3.new(0, -1000, 0)
            end
            task.wait(0.01)
        end

        task.wait(0.05)
        if myRoot then
            myRoot.CFrame = savedCF
            myRoot.AssemblyLinearVelocity = Vector3.zero
        end
        
        isVoidBaiting = false
        Library:Notify("Void Bait Executed Successful!", 2)
    end)
end

